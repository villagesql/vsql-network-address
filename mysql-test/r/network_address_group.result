INSTALL EXTENSION vsql_network_address;
DROP TABLE IF EXISTS test_network_group;
CREATE TABLE test_network_group (
id INT PRIMARY KEY,
ip INET,
net CIDR
);
INSERT INTO test_network_group VALUES
(1, '192.168.1.10', '192.168.1.0/24'),
(2, '192.168.1.10', '192.168.1.0/24'),
(3, '192.168.1.10', '192.168.1.0/24'),
(4, '10.0.0.1',     '10.0.0.0/8'),
(5, '10.0.0.1',     '10.0.0.0/8'),
(6, '172.16.5.4',   '172.16.0.0/12');
INSERT INTO test_network_group VALUES
(7, '2001:db8::1', '2001:db8::/32'),
(8, '2001:db8::1', '2001:db8::/32');
SELECT COUNT(DISTINCT ip) AS distinct_ip FROM test_network_group;
distinct_ip
4
SELECT COUNT(DISTINCT net) AS distinct_net FROM test_network_group;
distinct_net
4
SELECT ip, COUNT(*) AS n FROM test_network_group GROUP BY ip ORDER BY ip;
ip	n
10.0.0.1	2
172.16.5.4	1
192.168.1.10	3
2001:0db8:0000:0000:0000:0000:0000:0001	2
SELECT net, COUNT(*) AS n FROM test_network_group GROUP BY net ORDER BY net;
net	n
10.0.0.0/8	2
172.16.0.0/12	1
192.168.1.0/24	3
2001:0db8:0000:0000:0000:0000:0000:0000/32	2
SELECT COUNT(*) AS ip_groups FROM (SELECT ip FROM test_network_group GROUP BY ip) g;
ip_groups
4
SELECT COUNT(*) AS net_groups FROM (SELECT net FROM test_network_group GROUP BY net) g;
net_groups
4
DROP TABLE test_network_group;
UNINSTALL EXTENSION vsql_network_address;
